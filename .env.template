# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Paths (Windows users can use C:\Path\To\Folder or relative paths)
# On Railway, do NOT set these: attach a volume instead and the app stores everything on it
# automatically (via RAILWAY_VOLUME_MOUNT_PATH). Setting these overrides the volume.
# DATA_DIR=/data   # same idea on any other host: keep all files under one folder
DOWNLOAD_PATH=./downloads
VIDEO_PATH=./videos
CLIPS_PATH=./clips
TEMP_PATH=./temp
# ANALYSIS_RESULTS_PATH=./analysis_results

# Clip Processing Settings
MAX_CLIP_DURATION=60
MIN_CLIP_DURATION=15
TOP_CLIPS_TO_SHOW=10

# Audio Analysis Settings
AUDIO_SPIKE_THRESHOLD=0.7
SCENE_CHANGE_THRESHOLD=30.0

# Batch Processing Settings
MAX_PLAYLIST_VIDEOS=50
BATCH_DOWNLOAD_THREADS=3
