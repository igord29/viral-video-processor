# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Paths (Windows users can use C:\Path\To\Folder or relative paths)
# On Railway, attach a volume and the app stores everything on it automatically (via
# RAILWAY_VOLUME_MOUNT_PATH). Relative paths like the ones below are placed inside the volume;
# an absolute path is used as-is and will NOT be on the volume.
# DATA_DIR=/data   # same idea on any other host: keep all files under one folder
DOWNLOAD_PATH=./downloads
VIDEO_PATH=./videos
CLIPS_PATH=./clips
TEMP_PATH=./temp
# ANALYSIS_RESULTS_PATH=./analysis_results

# YouTube cookies, if YouTube shows "Sign in to confirm you're not a bot" (see README: YouTube bot check).
# Paste the contents of an exported cookies.txt, or give the path to the file. Keep these private.
# YOUTUBE_COOKIES=
# YOUTUBE_COOKIES_FILE=

# Password for the web app (see README: Password for the web app). With it set, the web app shows
# a login page and nothing works without the password. Set it wherever the app is reachable from
# the internet, such as Railway. Leave it unset on your own computer for no login.
# APP_PASSWORD=
# Signs the login cookie. Optional: with a Railway volume or DATA_DIR the app creates its own key
# and keeps it there. Without either, set a long random value or you are logged out on every restart.
# SECRET_KEY=

# Clip Processing Settings
MAX_CLIP_DURATION=60
MIN_CLIP_DURATION=15
TOP_CLIPS_TO_SHOW=10

# Audio Analysis Settings
AUDIO_SPIKE_THRESHOLD=0.7
SCENE_CHANGE_THRESHOLD=30.0

# Batch Processing Settings
MAX_PLAYLIST_VIDEOS=50
BATCH_DOWNLOAD_THREADS=3
# Most links accepted in one "Download Multiple Videos" list on the web app's Download page
MAX_BATCH_URLS=25
